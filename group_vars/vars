# deployment vars
ssh_keys:
  - ssh-ed25519 AAAAC3foobarbaz/125bafsaig my-ssh-key

ssh_privatekey: ~/.ssh/my-ssh-key

instance_prefix: my-linode-label
cluster_size: 2

# See https://api.linode.com/v4/linode/types for the full list of available Linode instance types.
type: g6-dedicated-2

# See https://api.linode.com/v4/regions for the full list of available Linode regions. Make sure the type you select is available in the region you select.
# You only need to specify one region, but you can specify multiple regions if you want to deploy across multiple regions.
region:
  - us-ord
  - us-mia

image: linode/ubuntu26.04
linode_tags:

firewall_label: my-secure-firewall

vpc_label:

# Optional settings for DNS
domain_name:
ttl_sec:

sudo_username: admin

local_cluster_ports:
  - 22

remote_cluster_ports:
  - 22
